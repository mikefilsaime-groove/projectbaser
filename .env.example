# ProjectBaser environment variable names (values are set per deployment,
# never committed).

# ---------------------------------------------------------------------------
# Scale Plus Pro Max Team Workspaces adapter (DISABLED BY DEFAULT).
# Do not set SCALE_TEAM_WORKSPACES_ENABLED=true until the pending migration
# in server/services/store/sqlstore/migrations-pending/ has been reviewed,
# approved, and applied, and the application passes the central certification
# matrix. The client-side flag is delivered through /api/v2/clientConfig, so
# no separate client environment variable is needed.
# ---------------------------------------------------------------------------
SCALE_TEAM_WORKSPACES_ENABLED=false
SCALE_WORKSPACE_HUB_URL=
SCALE_WORKSPACE_CLIENT_ID=
SCALE_WORKSPACE_CLIENT_SECRET=
