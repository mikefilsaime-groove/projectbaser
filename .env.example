# ProjectBaser file storage. Keep real credentials in a secret store or a
# server-owned environment file; never commit them.
FOCALBOARD_FILES_DRIVER=amazons3
FOCALBOARD_FILES_S3_ACCESS_KEY_ID=
FOCALBOARD_FILES_S3_SECRET_ACCESS_KEY=
FOCALBOARD_FILES_S3_BUCKET=projectbaser
FOCALBOARD_FILES_S3_PATH_PREFIX=
FOCALBOARD_FILES_S3_REGION=nyc3
FOCALBOARD_FILES_S3_ENDPOINT=nyc3.digitaloceanspaces.com
FOCALBOARD_FILES_S3_SSL=true
FOCALBOARD_FILES_S3_SIGN_V2=false
FOCALBOARD_FILES_S3_SSE=false
FOCALBOARD_FILES_S3_TRACE=false
FOCALBOARD_FILES_S3_TIMEOUT=30000
